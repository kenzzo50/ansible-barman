pipeline {
    agent any

    environment {
        HOST_WORKSPACE = '/home/ers/workspace/ansible-barman'
    }

    triggers {
        // Execução diária às 15:00 (1 hora após o backup diário das 14:00)
        cron('0 15 * * *')
    }

    stages {
        stage('Sincronizar Repositório') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "cd ${HOST_WORKSPACE} && git pull origin main"
                    """
                }
            }
        }

        stage('Executar Backup 3-2-1 Offsite Cloud Sync') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "cd ${HOST_WORKSPACE} && sudo ansible-playbook playbooks/sync-offsite.yml"
                    """
                }
            }
        }

        stage('Verificar Métrica no InfluxDB') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "curl -sG 'http://127.0.0.1:8086/query?db=telegraf' --data-urlencode 'q=SELECT * FROM barman_offsite_sync ORDER BY time DESC LIMIT 1'"
                    """
                }
            }
        }
    }
}
