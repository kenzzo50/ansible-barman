pipeline {
    agent any

    environment {
        HOST_WORKSPACE = '/home/ers/workspace/ansible-barman'
        MAIL_TO = 'kenzzo50@gmail.com'
    }

    triggers {
        // Agendamento diário às 03:00 da madrugada
        cron('0 3 * * *')
    }

    stages {
        stage('Sincronizar Repositório') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "cd ${HOST_WORKSPACE} && git fetch origin && git reset --hard origin/main"
                    """
                }
            }
        }

        stage('Executar Snapshot Completo da Infraestrutura') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "cd ${HOST_WORKSPACE} && ansible-playbook playbooks/full-infra-backup-r2.yml"
                    """
                }
            }
        }

        stage('Obter Detalhes do Snapshot Gerado') {
            steps {
                sshagent(credentials: ['ssh-ubuntu']) {
                    script {
                        def snapshotInfo = sh(
                            script: """ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "ls -lh /var/backups/infra-snapshots/infra_full_snapshot_*.tar.gz | tail -n 1 | awk '{print \\\$9, \\\$5}'" """,
                            returnStdout: true
                        ).trim()
                        def dotfilesInfo = sh(
                            script: """ssh -o StrictHostKeyChecking=no ers@172.17.0.1 "ls -lh /var/backups/infra-snapshots/home_dotfiles_*.tar.gz.enc | tail -n 1 | awk '{print \\\$9, \\\$5}'" """,
                            returnStdout: true
                        ).trim()
                        env.SNAPSHOT_DETAILS = snapshotInfo
                        env.DOTFILES_DETAILS = dotfilesInfo
                        echo "Último snapshot gerado: ${env.SNAPSHOT_DETAILS}"
                        echo "Último dotfiles cifrado gerado: ${env.DOTFILES_DETAILS}"
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                mail to: env.MAIL_TO,
                     subject: "🛡️ [Disaster Recovery] Snapshot Completo e Dotfiles Cifrados Salvos na Nuvem!",
                     body: """Prezado Administrador,

O Backup Consolidado de Disaster Recovery de toda a sua infraestrutura e dotfiles pessoais foi concluído e transmitido com sucesso para o Cloudflare R2 e processado para o Google Drive!

=======================================================
RESUMO DO DISASTER RECOVERY MULTI-NUVEM
=======================================================
• Snapshot de Infraestrutura: ${env.SNAPSHOT_DETAILS}
• Pacote Dotfiles & Chaves: ${env.DOTFILES_DETAILS} (Criptografado AES-256 com Vault Pass)
• Destinos na Nuvem:
  - Primário: Cloudflare R2 (Bucket 'ers-barman-backups' / prefixo 'infra-snapshots/')
  - Redundância Secundária: Google Drive ('ers-infra-backups/' via rclone)
• Formato: Pacotes compactados tar.gz / tar.gz.enc + Checksums SHA256
• Retenção Automática: Últimos 3 snapshots na nuvem e no host local
• Jenkins Build: ${env.BUILD_URL}

COMPACTAÇÃO E SERVIÇOS SALVOS NO SNAPSHOT:
1. PostgreSQL 17 (pg_dumpall de todos os 9 bancos: nexus3, zabbix7, grafana11, migration, keycloak, n8n_db, typebot_db, evolution_db, terraform_security)
2. MySQL 9.0 (mysqldump completo: gitea1_22 e mysql_app_db)
3. OpenLDAP (slapcat completo: schema config e diretório ou=users,dc=erscloudops,dc=org)
4. Jenkins CI/CD (Jobs, Pipelines, Users, Secrets e Credentials)
5. Gerrit Code Review (Repositórios Bare, Reviews, Históricos e Configurações)
6. Gitea (Configurações, Chaves SSH e Repositórios)
7. InfluxDB (Backup portátil da base de métricas 'telegraf')
8. Dotfiles & Chaves (/home/ers: .ssh, .gnupg, .docker, .ansible_vault_pass, .cntb.yaml, .jira_config, .gitconfig, etc. cifrados)
9. Manifesto de integridade com lista de contêineres e hashes SHA256

COMO RESTAURAR OS DOTFILES E CHAVES:
openssl enc -d -aes-256-cbc -pbkdf2 -in home_dotfiles_*.tar.gz.enc -out home_dotfiles.tar.gz -pass file:~/.ansible_vault_pass
tar -xzf home_dotfiles.tar.gz -C /home/ers/

Atenciosamente,
Jenkins CI/CD — CloudOps Lab
"""
            }
        }
        failure {
            script {
                mail to: env.MAIL_TO,
                     subject: "🚨 [Disaster Recovery] FALHA no Snapshot de Infraestrutura",
                     body: """Prezado Administrador,

A execução do snapshot completo da infraestrutura para o Cloudflare R2 FALHOU.
Por favor, verifique os logs do build no Jenkins:
${env.BUILD_URL}

Atenciosamente,
Jenkins CI/CD — CloudOps Lab
"""
            }
        }
    }
}
